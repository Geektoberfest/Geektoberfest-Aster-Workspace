# Port the API listens on
PORT=5001

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aster-workspace

# Long random string used to sign JWTs (required)
JWT_SECRET=replace-with-a-long-random-string

# Token lifetime, e.g. 7d, 12h
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# development | production (production enables Secure cookies)
NODE_ENV=development

# Where uploaded images are stored on disk (default: server/uploads)
# UPLOAD_DIR=./uploads
